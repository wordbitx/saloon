# Database connection used by Drizzle. For Supabase use its Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase project configuration — required when enabling authenticated tenants.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 only. Keep disabled until Meta Business verification and templates are approved.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
