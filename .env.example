# Postgres connection for staff logins and managed salon workspaces.
# Blank = temporary single-process demo only. For Supabase use its Postgres URL.
DATABASE_URL=

# First owner account (only seeded when no active owner exists). Supply a strong,
# unique password before a production deployment; production has no default owner password.
# For local development with these unset: admin@glowsalon.pk / GlowAdmin@2026
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required for stable sessions across production instances/restarts.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Supabase project configuration (optional — the app uses DATABASE_URL above).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 only. Keep disabled until Meta Business verification and templates are approved.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
