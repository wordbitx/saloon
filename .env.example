# Database connection used by Drizzle and by the staff-login store.
# For Supabase use its Postgres connection string (Project settings → Database).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Staff login (owner / manager / reception). These seed the FIRST owner account
# only when no active owner exists yet. Change the password after first login.
ADMIN_EMAIL=admin@glowsalon.pk
ADMIN_PASSWORD=GlowAdmin@2026

# Optional but recommended: fixed secret for signing admin session cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Supabase project configuration (optional — the app uses DATABASE_URL above).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 only. Keep disabled until Meta Business verification and templates are approved.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
